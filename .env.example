SESSION_SECURE = false
SESSION_SAMESITE = Lax
QUEUE_DRIVER = redis

[APP]
DEBUG = false
KEY = "CHANGE_ME_TO_RANDOM_32_CHAR_STRING"

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = pan_search
USERNAME = root
PASSWORD = "your-db-password"
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX = ""
DEPLOY = 0
RW_SEPARATE = false

[REDIS]
HOST = 127.0.0.1
PORT = 6379
PASSWORD = "your-redis-password"
SELECT = 0
PREFIX = pansou:
TIMEOUT = 5

[MAIL]
SMTP_HOST = smtp.qq.com
SMTP_PORT = 465
SMTP_USER = "your-smtp-user"
SMTP_PASS = "your-smtp-pass"
SMTP_FROM = "your-from-email@example.com"
SMTP_FROM_NAME = "网盘搜索"
SMTP_ENCRYPTION = ssl

[PAY]
CAIHONG_PID = "your-caihong-pid"
CAIHONG_KEY = "your-caihong-key"
CAIHONG_API = "https://your-pay-gateway.com"
NOTIFY_URL = ""
RETURN_URL = ""

[SECURITY]
AES_KEY = "CHANGE_ME_TO_RANDOM_32_CHAR_STRING"
SESSION_PREFIX = pansou_
ADMIN_SESSION_PREFIX = pansou_admin_

[CORS]
ALLOW_ORIGIN = ""
