{
    "name": "laobi465/pansou",
    "description": "轻量网盘资源搜索引擎 - 原生PHP模板 + ThinkPHP8",
    "type": "project",
    "keywords": ["thinkphp", "pan-search", "search-engine"],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "guzzlehttp/guzzle": "^7.9",
        "phpmailer/phpmailer": "^6.9",
        "topthink/framework": "^8.0",
        "topthink/think-migration": "^3.0",
        "topthink/think-queue": "^3.0",
        "topthink/think-view": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/",
            "Pansou\\": "extend/Pansou/"
        },
        "psr-0": {
            "": "extend/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "extra": {
        "think": {
            "services": []
        }
    },
    "minimum-stability": "stable"
}
