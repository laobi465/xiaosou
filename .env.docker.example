# =============================================================================
# Docker 部署环境变量样例
# 使用方式：
#   1. cp .env.docker.example .env.docker
#   2. 修改其中的密码 / 邮件 / 支付配置
#   3. docker-compose --env-file .env.docker up -d
# =============================================================================

# ---------- Web 服务端口 ----------
WEB_PORT=8080

# ---------- 数据库 ----------
DB_NAME=pan_search
DB_USER=pansou
DB_PASSWORD=pansou_2024
DB_ROOT_PASSWORD=pansou_root_2024
DB_EXPOSE_PORT=3306

# ---------- Redis ----------
REDIS_PASSWORD=
REDIS_EXPOSE_PORT=6379

# ---------- 应用 ----------
APP_DEBUG=false
APP_KEY=
SESSION_SECURE=true
SESSION_SAMESITE=Lax
AES_KEY=
CORS_ALLOW_ORIGIN=

# ---------- 邮件 SMTP ----------
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=网盘搜索
MAIL_ENCRYPTION=ssl

# ---------- 彩虹易支付 ----------
PAY_PID=
PAY_KEY=
PAY_API=
PAY_NOTIFY_URL=
PAY_RETURN_URL=

# ---------- 管理员账号（首次启动时自动创建） ----------
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
